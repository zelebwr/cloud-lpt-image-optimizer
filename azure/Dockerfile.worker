FROM python:3.11-slim

WORKDIR /app

# Install dependensi tingkat sistem yang dibutuhkan oleh Pillow
RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install pustaka Python
RUN pip install --no-cache-dir fastapi uvicorn pillow pydantic requests

# Salin seluruh modul kode yang dibutuhkan worker
COPY schema.py .
COPY worker_service.py .
COPY image_processor.py .

EXPOSE 8000

CMD ["uvicorn", "worker_service:app", "--host", "0.0.0.0", "--port", "8000"]
