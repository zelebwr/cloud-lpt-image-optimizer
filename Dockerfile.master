FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn pydantic requests numpy

COPY schema.py .
COPY env_config.py .
COPY lpt_logic.py .
COPY rr_logic.py .
COPY scheduler_engine.py .

EXPOSE 8000

CMD ["uvicorn", "scheduler_engine:app", "--host", "0.0.0.0", "--port", "8000"]